# QR Tiger sign-in.
#
# LOCALLY: copy this file to .env.local and fill it in. Leave it empty and the
# app opens a browser window on the Generate step and waits for you to sign in
# by hand instead.
#
# ON VERCEL: there is no screen, so these two are REQUIRED. Add them in
# Project Settings -> Environment Variables, not in a committed file.

QRTIGER_EMAIL=
QRTIGER_PASSWORD=

# ---------------------------------------------------------------------------
# Optional, local only
# ---------------------------------------------------------------------------
# HEADLESS=1                 hide the browser window (use this to check whether
#                            the sign-in works without a screen, which is what
#                            Vercel will have to do)
# CHROMIUM_PATH=             use a Chromium you already have instead of the one
#                            npm run setup downloads
